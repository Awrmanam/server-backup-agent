[Unit]
Description=Server Backup Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/server-backup-agent/secrets.env
ExecStart=/opt/server-backup-agent/.venv/bin/server-backup-agent --config /etc/server-backup-agent/config.toml
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
